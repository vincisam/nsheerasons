{
  "devCommand": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/ai/jewellery-design", "destination": "/api/ai/jewellery-design.js" },
    { "source": "/api/ai/stone-suggestion", "destination": "/api/ai/stone-suggestion.js" },
    { "source": "/api/ai/(.*)", "destination": "/api/index" },
    { "source": "/api/auth/(.*)", "destination": "/api/index" },
    { "source": "/api/client/(.*)", "destination": "/api/index" },
    { "source": "/api/jewellery/(.*)", "destination": "/api/index" },
    { "source": "/api/orders/(.*)", "destination": "/api/index" },
    { "source": "/api/payments/(.*)", "destination": "/api/index" },
    { "source": "/api/invoices/(.*)", "destination": "/api/index" },
    { "source": "/api/admin/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
